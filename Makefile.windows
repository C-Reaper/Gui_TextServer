# === Makefile.windows ===

CC = gcc
WARNINGS = -Werror
CFLAGS = -O0 -mavx2 -std=gnu17 $(WARNINGS)
SYSTEM_ROOT ?= ../../../System
INCLUDES = -Isrc -I$(SYSTEM_ROOT)/Static/Library
LDFLAGS = -lm -luser32 -lgdi32 -lwinmm -lxinput9_1_0 -lole32 -loleaut32 -lwindowscodecs -lmfplat -lmf -lmfreadwrite -lmfuuid -lws2_32 -lshlwapi
SERVER_HOST ?= 192.168.178.99
SERVER_PORT ?= 5000
SERVER_PORT_DEFINE = -DNET_SERVER_PORT='"$(SERVER_PORT)"'
CLIENT_DEFINES = -DNET_SERVER_HOST='"$(SERVER_HOST)"' $(SERVER_PORT_DEFINE)

SRC_DIR = src
BUILD_DIR = build

SERVER = $(BUILD_DIR)/Server.exe
CLIENT = $(BUILD_DIR)/Client.exe

ifeq ($(findstring cmd,$(SHELL)),cmd)
    MKDIR_CMD = if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"
    CLEAN_CMD = if exist "$(BUILD_DIR)" del /Q "$(BUILD_DIR)\*" & if exist "$(TARGET)" del "$(TARGET)"
    RUN_CMD_EXE = $(SERVER)
    RUN_CMD_CLIENT = $(CLIENT)
else
    MKDIR_CMD = mkdir -p $(BUILD_DIR)
    CLEAN_CMD = rm -f $(BUILD_DIR)/*.o $(TARGET)
    RUN_CMD_EXE   = ./$(SERVER)
    RUN_CMD_CLIENT   = ./$(CLIENT)
endif

$(BUILD_DIR):
	$(MKDIR_CMD)

all: $(BUILD_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) $(SERVER_PORT_DEFINE) $(SRC_DIR)/Server.c -o $(SERVER) $(LDFLAGS)
	$(CC) $(CFLAGS) $(INCLUDES) $(CLIENT_DEFINES) $(SRC_DIR)/Client.c -o $(CLIENT) $(LDFLAGS)

alldebug: $(BUILD_DIR)
	$(CC) -g $(CFLAGS) $(INCLUDES) $(SERVER_PORT_DEFINE) $(SRC_DIR)/Server.c -o $(SERVER) $(LDFLAGS)
	$(CC) -g $(CFLAGS) $(INCLUDES) $(CLIENT_DEFINES) $(SRC_DIR)/Client.c -o $(CLIENT) $(LDFLAGS)

exe:
	./$(RUN_CMD_EXE)

client:
	./$(RUN_CMD_CLIENT)

debug:
	gdb $(SERVER)

clean:
	$(CLEAN_CMD)

do: clean all exe
dg: clean alldebug debug

# === Makefile.windows ===